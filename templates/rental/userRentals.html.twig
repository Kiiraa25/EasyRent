{% extends 'dashBoard/base.html.twig' %}

{% block importmap %}
	{{ parent() }}
	{{ importmap(['componentsStyle']) }}
{% endblock %}

{% block title %}Liste des Locations
{% endblock %}

{% block stylesheets %}
	<style>
		/* Structure principale */
		.content-container {
			width: 90%;
			background-color: #ffffff;
			border-radius: 8px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			padding: 30px;
			margin-top: 20px;
			max-height: 84vh;
			overflow: auto;
		}

		/* Formulaire de filtre */
		.filter-form {
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 10px;
			margin-bottom: 20px;
		}

		.filter-form select,
		.filter-form button {
			padding: 10px;
			border-radius: 8px;
			border: 1px solid #ccc;
			font-size: 14px;
		}

		.filter-form button {
			background-color: #282F4B;
			color: #ffffff;
			font-weight: bold;
			cursor: pointer;
			transition: background-color 0.2s;
		}

		.filter-form button:hover {
			background-color: #1d2337;
		}

		/* Liste des locations */
		.rental-item {
			display: grid;
			grid-template-columns: 80px 1fr 1fr 1fr 1fr 1fr;
			align-items: center;
			background-color: white;
			border-radius: 10px;
			box-shadow: rgba(0, 0, 0, 0.05) 2px 4px 8px;
			padding: 15px;
			margin-bottom: 20px;
			width: 97%;
			gap: 10px;
			transition: transform 0.2s, box-shadow 0.2s;
		}

		.rental-item:hover {
			transform: scale(1.02);
			box-shadow: rgba(0, 0, 0, 0.1) 2px 6px 12px;
		}

		/* Image de la location */
		.rental-image {
			width: 80px;
			height: 80px;
			background-color: #282F4B;
			border-radius: 8px;
			display: flex;
			align-items: center;
			justify-content: center;
			color: white;
			font-weight: bold;
			font-size: 14px;
		}

		/* Détails de la location */
		.rental-details,
		.rental-owner,
		.rental-renter,
		.rental-price,
		.rental-status {
			color: #282F4B;
			display: flex;
			flex-direction: column;
			gap: 5px;
			font-size: 14px;
		}

		.rental-details h3,
		.rental-owner strong,
		.rental-renter strong,
		.rental-price strong {
			color: #FF866F;
			font-size: 15px;
		}

		/* Boutons d'actions */
		.rental-actions {
			display: flex;
			gap: 8px;
		}

		.btn {
			padding: 8px 12px;
			font-size: 12px;
			font-weight: bold;
			color: white;
			border: none;
			border-radius: 5px;
			cursor: pointer;
			text-decoration: none;
			transition: background-color 0.2s;
		}

		.btn.cancel-button {
			background-color: #FF6347;
		}

		.btn.modify-button {
			background-color: #6495ED;
		}

		.btn.accept-button {
			background-color: #32CD32;
		}

		.btn.refuse-button {
			background-color: #FF6347;
		}

		.btn:hover {
			opacity: 0.85;
		}

		.tab-container {
			display: flex;
			justify-content: space-between;
			margin-bottom: 20px;
		}

		.tabs {
			display: flex;
			overflow-x: auto;
		}

		.tab {
			padding: 10px 20px;
			background-color: #f1f1f1;
			margin-right: 10px;
			text-decoration: none;
			color: #333;
			border-radius: 5px;
			transition: background-color 0.3s;
		}

		.tab.active {
			background-color: #eb8072;
			color: white;
		}

		.tab:hover {
			background-color: #eb8072;
			color: white;
		}

		.filters-block {
			display: flex;
			justify-content: space-between;
		}
	</style>
{% endblock %}

{% block content %}
	<div class="admin-dashboard-content">
		<h1 class="dashboard-title ">Mes Locations</h1>

		<div class="content-container">

			<div
				class="filters-block">
				<!-- Formulaire de filtre -->
				<form method="get" action="{{ path('app_user_rental_requests') }}" class="filter-form">

					<label for="filter">Afficher les locations en tant que :</label>
					<select name="filter" id="filter">
						<option value="renter" {% if filter == 'renter' %} selected {% endif %}>Locataire</option>
						<option value="owner" {% if filter == 'owner' %} selected {% endif %}>Propriétaire</option>
					</select>
					<button type="submit" class="btn">Filtrer</button>
				</form>

				<div class="tab-container">
					<div class="tabs">
						<a href="{{ path('app_user_rentals', { 'status': 'a_venir', 'filter': filter }) }}" class="tab {% if status == 'a_venir' %}active{% endif %}">
							À venir
						</a>
						<a href="{{ path('app_user_rentals', { 'status': 'en_cours', 'filter': filter }) }}" class="tab {% if status == 'en_cours' %}active{% endif %}">
							En cours
						</a>
						<a href="{{ path('app_user_rentals', { 'status': 'termine', 'filter': filter }) }}" class="tab {% if status == 'termine' %}active{% endif %}">
							Terminées
						</a>
						<a href="{{ path('app_user_rentals', { 'status': 'all', 'filter': filter }) }}" class="tab {% if status == 'all' %}active{% endif %}">
							Tout
						</a>
					</div>
				</div>
			</div>

			{% if rentals is empty %}
				<p>Vous n'avez aucune demande de location pour le moment</p>
			{% else %}
				{% for rental in rentals %}

					<a href="{{ path('app_rental_show', {'id': rental.id}) }}" class="rental-details-link">
						<div
							class="rental-item">
							<!-- Image de la location -->
							<div class="rental-image">IMG</div>
						</a>
						<!-- Détails de la location -->
						<a href="{{ path('app_rental_show', {'id': rental.id}) }}" class="rental-details-link">
							<div class="rental-details">
								<h3>{{ rental.vehicle.model.name }}</h3>
								<p>Date de début :
									{{ rental.startDate ? rental.startDate|date('d/m/Y') : '' }}</p>
								<p>Date de fin :
									{{ rental.endDate ? rental.endDate|date('d/m/Y') : '' }}</p>
							</div>
						</a>


						{% if filter == 'owner' %}
							<!-- Afficher le locataire si le filtre est sur 'propriétaire' -->
							<div class="rental-renter">
								<strong>Locataire :</strong>
								<p>{{ rental.renter.profile.firstName }}
									{{ rental.renter.profile.lastName }}</p>
							</div>
						{% else %}
							<!-- Afficher le propriétaire si le filtre est sur 'locataire' -->
							<div class="rental-owner">
								<strong>Propriétaire :</strong>
								<p>{{ rental.vehicle.owner.profile.firstName }}
									{{ rental.vehicle.owner.profile.lastName }}</p>
							</div>
						{% endif %}


						<!-- Prix -->
						<a href="{{ path('app_rental_show', {'id': rental.id}) }}" class="rental-details-link">
							<div class="rental-price">
								<strong>Prix total :</strong>
								<p>{{ rental.totalPrice }}
									€</p>
							</div>
						</a>

						<!-- Statut -->
						<a href="{{ path('app_rental_show', {'id': rental.id}) }}" class="rental-details-link">
							<div class="rental-status">{{ rental.status.value }}</div>
						</a>
						<!-- Actions -->
						<div class="rental-actions">
							{% if rental.status.value == "validée" or rental.status.value == "en_cours" %}
								<a href="{{ path('app_rental_edit', { 'id': rental.id }) }}" class="btn modify-button">Modifier</a>
								<a href="{{ path('app_rental_cancel', { 'id': rental.id }) }}" onclick="return confirm('Voulez-vous vraiment annuler cette location ?')" class="btn cancel-button">Annuler</a>
							{% endif %}
						</div>
					</div>
				{% endfor %}
			{% endif %}
		</div>
	</div>
{% endblock %}
