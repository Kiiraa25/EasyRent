{% extends 'dashBoard/base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'adminDashboardStyle', 'componentsStyle', 'userListStyle']) }}
{% endblock %}

{% block title %}Mes demandes de Locations - Easy-Rent
{% endblock %}


{% block content %}
	<div class="admin-dashboard-content">
		<h1 class="dashboard-title ">Mes Demandes De Location</h1>

		<div
			class="content-container">

			<!-- Formulaire de filtre -->
			<form method="get" action="{{ path('app_user_rental_requests') }}" class="filter-form">

				<label for="filter">Afficher les locations en tant que :</label>
				<select name="filter" id="filter">
					<option value="renter" {% if filter == 'renter' %} selected {% endif %}>Locataire</option>
					<option value="owner" {% if filter == 'owner' %} selected {% endif %}>Propriétaire</option>
				</select>
				<button type="submit" class="btn">Filtrer</button>
			</form>

			{% if rentalRequests is empty %}
				<p>Vous n'avez aucune demande de location pour le moment</p>
			{% else %}
				{% for rental in rentalRequests %}

					<div class="rental-item">
						<a href="{{ path('app_rental_show', {'id': rental.id}) }}" class="rental-details-link">
							
							
							<!-- Image du véhicule -->
							<div class="vehicle-image">
							<img src="{{ vich_uploader_asset(rental.vehicle.photos[0], 'imageFile') }}" alt="Photo du véhicule">
							</div>
						</a>

						<!-- Détails de la location -->
						<a href="{{ path('app_rental_show', {'id': rental.id}) }}" class="rental-details-link">
							<div class="rental-details">
								<h3>{{ rental.vehicle.model.name }}</h3>
								<p>Date de début :
									{{ rental.startDate ? rental.startDate|date('d/m/Y') : '' }}</p>
								<p>Date de fin :
									{{ rental.endDate ? rental.endDate|date('d/m/Y') : '' }}</p>
							</div>
						</a>

						{% if filter == 'owner' %}
							<!-- Afficher le locataire si le filtre est sur 'propriétaire' -->
							<div class="rental-renter">
								<strong>Locataire :</strong>
								<p>{{ rental.renter.profile.firstName }}
									{{ rental.renter.profile.lastName }}</p>
							</div>
						{% else %}
							<!-- Afficher le propriétaire si le filtre est sur 'locataire' -->
							<div class="rental-owner">
								<strong>Propriétaire :</strong>
								<p>{{ rental.vehicle.owner.profile.firstName }}
									{{ rental.vehicle.owner.profile.lastName }}</p>
							</div>
						{% endif %}

						<!-- Prix -->
						<a href="{{ path('app_rental_show', {'id': rental.id}) }}" class="rental-details-link">
							<div class="rental-price">
								<strong>Prix total :</strong>
								<p>{{ rental.totalPrice }}
									€</p>
							</div>
						</a>

						<!-- Statut -->
						<a href="{{ path('app_rental_show', {'id': rental.id}) }}" class="rental-details-link">
							<div class="rental-status">{{ rental.status.value }}</div>
						</a>

						<!-- Actions -->
						<div class="item-actions">
							{% if rental.renter == app.user and (rental.status.value == "en_attente_validation" or rental.status.value == "en_cours")%}
								<a href="{{ path('app_rental_cancel', { 'id': rental.id }) }}" onclick="return confirm('Are you sure you want to cancel?')" class="btn cancel-button">Annuler</a>
								<a href="{{ path('app_rental_edit', { 'id': rental.id }) }}" class="btn modify-button">Modifier</a>
							{% elseif rental.vehicle.owner == app.user and rental.status.value == "en_attente_validation" %}
								<a href="{{ path('app_rental_accept', { 'id': rental.id }) }}" onclick="return confirm('Are you sure you want to accept?')" class="btn accept-button">Accepter</a>
								<a href="{{ path('app_rental_refuse', { 'id': rental.id }) }}" onclick="return confirm('Are you sure you want to refuse?')" class="btn refuse-button">Refuser</a>
							{% endif %}
						</div>
					</div>
				{% endfor %}
			{% endif %}
		</div>
	</div>
{% endblock %}
