{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'componentsStyle', 'showVehicleStyle', 'showVehicleThumbnailImage']) }}
{% endblock %}

{% block title %}Détails de la location - Easy-Rent
{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
	<main>
		<div
			class="vehicle-container">
			<!-- En-tête de la location -->
			<div class="vehicle-header">
				<div class="vehicle-picture">
					<img id="main-image" src="{{ vich_uploader_asset(rental.vehicle.photos[0], 'imageFile') }}" alt="Photo principale du véhicule">
				</div>

				<div class="thumbnails">
					{% for photo in rental.vehicle.photos %}
						<img src="{{ vich_uploader_asset(photo, 'imageFile') }}" alt="Miniature {{ loop.index }}" class="thumbnail {% if loop.first %}selected{% endif %}" onclick="changeMainImage('{{ vich_uploader_asset(photo, 'imageFile') }}', this)">
					{% endfor %}
				</div>
			</div>

			<!-- Informations sur la location -->
			<div class="vehicle-info">
				<h1>{{ rental.vehicle.model.brand.name }}
					{{ rental.vehicle.model.name }}</h1>
				<p>
					{{ rental.startDate|date('d/m/Y') }}
					-
					{{ rental.endDate|date('d/m/Y') }}
					<br>
					Statut :
					{{ rental.status.value }}
				</p>
			</div>

			<!-- Section Détails -->
			<div class="section">
				<h2>Détails de la location</h2>
				<div class="section-content">
					<div>
						<p>
							<strong>Client :</strong>
							{{ rental.renter.profile.firstName }}
							{{ rental.renter.profile.lastName }}</p>
						<p>
							<strong>Méthode de paiement :</strong>
							{{ rental.paymentMethod.value }}</p>
						<p>
							<strong>Limite de kilométrage :</strong>
							{{ rental.mileageLimit }}
							km</p>
						<p>
							<strong>Prix total :</strong>
							{{ rental.totalPrice }}
							€</p>
					</div>
					<div>
						<p>
							<strong>Créé le :</strong>
							{{ rental.createdAt|date('d/m/Y H:i') }}</p>
						<p>
							<strong>Dernière mise à jour :</strong>
							{{ rental.updatedAt|date('d/m/Y H:i') }}</p>
						{% if rental.status.value == 'ANNULEE' %}
							<p>
								<strong>Raison de l'annulation :</strong>
								{{ rental.cancellationReason }}</p>
							<p>
								<strong>Annulé par :</strong>
								{{ rental.cancelledBy.value }}</p>
						{% endif %}
					</div>
				</div>
			</div>

			<!-- Boutons d'action -->
			<div class="button-container">
				{% if rental.renter == app.user %}
					{% if rental.status.value in ['en_attente_validation', 'validée', 'en_cours'] %}
						<a href="{{ path('app_rental_edit', { 'id': rental.id }) }}" class="edit-button">Modifier</a>
						<a href="{{ path('app_rental_cancel', { 'id': rental.id }) }}" onclick="return confirm('Êtes-vous sûr de vouloir annuler ?')" class="edit-button">Annuler</a>
					{% endif %}
				{% elseif rental.vehicle.owner == app.user %}
					{% if rental.status.value == 'en_attente_validation' %}
						<a href="{{ path('app_rental_accept', { 'id': rental.id }) }}" onclick="return confirm('Êtes-vous sûr de vouloir accepter ?')" class="edit-button">Accepter</a>
						<a href="{{ path('app_rental_refuse', { 'id': rental.id }) }}" onclick="return confirm('Êtes-vous sûr de vouloir refuser ?')" class="edit-button">Refuser</a>
					{% elseif rental.status.value == 'validée' %}
						<a href="{{ path('app_rental_cancel', { 'id': rental.id }) }}" onclick="return confirm('Êtes-vous sûr de vouloir annuler ?')" class="edit-button">Annuler</a>
					{% endif %}
				{% endif %}
			</div>

			<!-- Retour à la liste -->

			<a href="{{ path('app_user_rentals') }}" class="back-link">Retour à la liste des locations</a>

		</div>
	</main>

	<script>
		function changeMainImage(imageUrl, thumbnail) {
const mainImage = document.getElementById('main-image');
mainImage.src = imageUrl;

// Réinitialiser la sélection des miniatures
document.querySelectorAll('.thumbnail').forEach(thumbnail => {
thumbnail.classList.remove('selected');
});

// Ajouter la classe sélectionnée à la miniature active
thumbnail.classList.add('selected');
}
	</script>
{% endblock %}
