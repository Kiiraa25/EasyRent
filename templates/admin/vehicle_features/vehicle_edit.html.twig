{% extends 'base.html.twig' %}

{% block title %}Éditer le véhicule{% endblock %}

{% block stylesheets %}
    <style>
        /* Global styles */
        body {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        h1 {
            color: #282F4B;
            text-align: center;
        }

        /* Form container */
        .form-container {
            width: 60%;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px 40px;
            margin-top: 20px;
        }

        /* Form elements */
        label {
            color: #282F4B;
            font-weight: bold;
            margin-top: 15px;
            display: inline-block;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            margin: 8px 0 16px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .form-control:focus {
            border-color: #FF866F;
            outline: none;
            box-shadow: 0 0 4px rgba(255, 134, 111, 0.4);
        }

        .btn-submit {
            display: block;
            width: 100%;
            padding: 10px;
            background-color: #FF866F;
            color: #ffffff;
            border: none;
            border-radius: 4px;
            font-size: 1em;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s ease;
            text-align: center;
            margin-top: 20px;
        }

        .btn-submit:hover {
            background-color: #e67564;
        }

        .back-link {
            display: inline-block;
            margin-top: 15px;
            color: #282F4B;
            text-decoration: none;
            font-weight: bold;
        }

        .back-link:hover {
            color: #FF866F;
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Éditer le véhicule</h1>

    <div class="form-container">
        {{ form_start(form, {'attr': {'onsubmit': 'return confirmUpdate()'}}) }}

        {{ form_label(form.mileage, 'Kilométrage') }}
        {{ form_widget(form.mileage, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.doors, 'Nombre de portes') }}
        {{ form_widget(form.doors, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.seats, 'Nombre de sièges') }}
        {{ form_widget(form.seats, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.description, 'Description') }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.color, 'Couleur') }}
        {{ form_widget(form.color, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.extraMileageRate, 'Tarif supplémentaire/km') }}
        {{ form_widget(form.extraMileageRate, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.pricePerDay, 'Tarif/jour') }}
        {{ form_widget(form.pricePerDay, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.address, 'Adresse') }}
        {{ form_widget(form.address, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.postalCode, 'Code postal') }}
        {{ form_widget(form.postalCode, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.city, 'Ville') }}
        {{ form_widget(form.city, {'attr': {'class': 'form-control'}}) }}

        <button type="submit" class="btn-submit">Mettre à jour le véhicule</button>

        {{ form_end(form) }}

        <a href="{{ path('app_admin_vehicles') }}" class="back-link">Retour à la liste des véhicules</a>
    </div>

    <script>
        function confirmUpdate() {
            return confirm("Êtes-vous sûr de vouloir mettre à jour les informations de ce véhicule ?");
        }
    </script>
{% endblock %}
