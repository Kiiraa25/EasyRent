{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app','dashbordStyle']) }}
{% endblock %}

{% block title %}Tableau de Bord Administrateur
{% endblock %}

{% block stylesheets %}
	<style>
		/* Styles généraux */
		body {
			font-family: Arial, sans-serif;
			background-color: #f4f6f8;
			display: flex;
			margin: 0;
			padding: 0;
		}

		/* Barre latérale */
		.sidebar {
			width: 240px;
			background-color: #1f2b45;
			color: white;
			padding: 20px;
		}

		.sidebar h3 {
			color: #ffffff;
			margin-bottom: 40px;
		}

		.sidebar ul {
			list-style-type: none;
			padding: 0;
		}

		.sidebar li {
			margin: 20px 0;
		}

		.sidebar a {
			color: #ffffff;
			text-decoration: none;
			font-size: 1.1em;
			display: flex;
			align-items: center;
		}

		.sidebar a:hover {
			color: #FF866F;
		}
	</style>
{% endblock %}

{% block body %}

	<div class="container">
		<div class="sidebar">
			<h3>Admin Dashboard</h3>
			<ul>
				<li><a href="#">Tableau de bord</a></li>
				<li><a href="{{path('app_admin_users')}}">Utilisateurs</a></li>
				<li><a href="{{path('app_admin_vehicles')}}">Véhicules</a></li>
				<li><a href="{{path('app_admin_rentals')}}">Locations</a></li>
				<li><a href="#">Rapports</a></li>
				<li><a href="#">Paramètres</a></li>
			</ul>
		</div>
		<div class="right-side-dashBoard">
			{% block content %}{% endblock %}
		</div>


	</div>

    {% block footer %}
        
    {% endblock %}
{% endblock %}
