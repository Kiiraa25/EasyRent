{% extends 'base.html.twig' %}

{% block title %}FAQ - Easy-Rent{% endblock %}

{% block meta_description %}
<meta name="description" content="Vous avez des questions sur Easy-Rent ? Découvrez notre FAQ pour tout savoir sur la location de voitures entre particuliers : fonctionnement, sécurité, assurance et plus encore.">

{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f7f7f7;
            color: #333;
        }

        .FAQ {
            max-width: 800px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
        }

        .FAQ h1 {
            font-size: 2em;
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #FF866F;
            padding-bottom: 10px;
            color: #282F4B;
        }

        .FAQ h2 {
            font-size: 1.4em;
            color: #282F4B;
           border-bottom: 1px solid #282F4B50;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .FAQ .faq-section {
            margin-top: 20px;
        }

        .FAQ .faq-item {
        }

        .FAQ .faq-item h3 {
            font-size: 0.9em;
            color: #282F4B;
            margin: 0 0 5px;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .FAQ .faq-item h3:hover {
            color: #FF866F;
        }

        .FAQ .faq-item p {
            margin: 0;
            margin-bottom: 8px;
            font-size: 0.8em;
            line-height: 1.6;
            color: #666;
            display: none; /* Par défaut, les réponses sont masquées */
        }

        .FAQ .faq-item.active p {
            display: block;
        }

        .FAQ footer {
            margin-top: 30px;
            text-align: center;
            font-size: 0.9em;
            color: #666;
        }

        .FAQ footer a {
            color: #282F4B;
        }
        .FAQ section{
            width: 90%;
        }
    </style>
{% endblock %}

{% block content %}
<main class="FAQ">
    <h1>FAQ - Foire Aux Questions</h1>

    <section class="faq-section">
        <h2>Général</h2>
        <div class="faq-item">
            <h3>Qu'est-ce que Easy-Rent ?</h3>
            <p>
                Easy-Rent est une plateforme de location de voitures entre particuliers, permettant aux propriétaires de véhicules de les louer et aux locataires de réserver facilement une voiture.
            </p>
        </div>
        <div class="faq-item">
            <h3>Comment fonctionne Easy-Rent ?</h3>
            <p>
                Les propriétaires publient une annonce pour leur véhicule. Les locataires recherchent et réservent une voiture. Une fois la réservation confirmée, les deux parties se rencontrent pour l'échange.
            </p>
        </div>
    </section>

    <section class="faq-section">
        <h2>Pour les Locataires</h2>
        <div class="faq-item">
            <h3>Comment réserver une voiture ?</h3>
            <p>
                Inscrivez-vous sur Easy-Rent, recherchez un véhicule dans votre région, sélectionnez les dates et validez votre réservation en ligne.
            </p>
        </div>
        <div class="faq-item">
            <h3>Quels documents dois-je fournir ?</h3>
            <p>
                Vous devez fournir une pièce d'identité valide, un permis de conduire en cours de validité, et dans certains cas, des informations supplémentaires peuvent être demandées.
            </p>
        </div>
        <div class="faq-item">
            <h3>Comment se déroule l'échange du véhicule ?</h3>
            <p>
                Vous rencontrez le propriétaire au lieu convenu pour l'échange. Un état des lieux du véhicule est réalisé avant et après la location.
            </p>
        </div>
    </section>

    <section class="faq-section">
        <h2>Pour les Propriétaires</h2>
        <div class="faq-item">
            <h3>Comment publier une annonce pour mon véhicule ?</h3>
            <p>
                Inscrivez-vous sur Easy-Rent, créez une annonce en renseignant les informations nécessaires (photos, description, prix) et publiez-la.
            </p>
        </div>
        <div class="faq-item">
            <h3>Mon véhicule est-il assuré ?</h3>
            <p>
                Oui, Easy-Rent propose une couverture d'assurance pour chaque location afin de protéger les propriétaires et locataires.
            </p>
        </div>
        <div class="faq-item">
            <h3>Que faire en cas de dommage sur mon véhicule ?</h3>
            <p>
                En cas de dommage, contactez immédiatement notre service client. Un rapport sera établi pour activer la couverture d'assurance.
            </p>
        </div>
    </section>

    <section class="faq-section">
        <h2>Assistance</h2>
        <div class="faq-item">
            <h3>Comment contacter le support client ?</h3>
            <p>
                Vous pouvez nous contacter via le formulaire de contact sur notre site ou par email à <a href="mailto:support@easy-rent.fr">support@easy-rent.fr</a>.
            </p>
        </div>
        <div class="faq-item">
            <h3>Que faire en cas de problème avec une réservation ?</h3>
            <p>
                En cas de problème, contactez rapidement notre support client. Nous sommes là pour vous aider à résoudre tout litige ou difficulté.
            </p>
        </div>
    </section>

    <footer>
        <p>© 2024 Easy-Rent. Tous droits réservés. | <a href="#">Contactez-nous</a></p>
    </footer>
</main>

<script>
        document.addEventListener('DOMContentLoaded', () => {
            const faqItems = document.querySelectorAll('.faq-item h3');
            faqItems.forEach(item => {
                item.addEventListener('click', () => {
                    const parent = item.parentElement;
                    parent.classList.toggle('active');
                });
            });
        });
    </script>
{% endblock %}
