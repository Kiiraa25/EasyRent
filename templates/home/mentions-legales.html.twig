{% extends 'base.html.twig' %}

{% block title %}Mentions Légales - Easy-Rent{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f7f7f7;
            color: #333;
        }

        .mentions-legales {
            max-width: 800px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
        }

        .mentions-legales h1, .mentions-legales h2 {
            color: #282F4B;
        }

        .mentions-legales h1 {
            font-size: 2em;
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #FF866F;
            padding-bottom: 10px;
        }

        .mentions-legales h2 {
            font-size: 1.4em;
            margin-top: 30px;
            border-bottom: 1px solid #FF866F;
            padding-bottom: 8px;
        }

        .mentions-legales p, .mentions-legales li {
            font-size: 1em;
            line-height: 1.6;
            margin: 10px 0;
        }

        .mentions-legales ul {
            margin-left: 20px;
        }

        .mentions-legales footer {
            margin-top: 30px;
            text-align: center;
            font-size: 0.9em;
            color: #666;
        }

        .mentions-legales footer a {
            color: #282F4B;
        }
        .mentions-legales section{
            width: 90%;
        }
    </style>
{% endblock %}

