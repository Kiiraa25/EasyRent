{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'registerStyle']) }}
{% endblock %}

{% block title %}Se connecter - Easy-Rent
{% endblock %}

{% block body %}
	<main>
		<form method="post">


			{% if app.user %}
				<div class="mb-3">
					You are logged in as
					{{ app.user.userIdentifier }},
					<a href="{{ path('app_logout') }}">Logout</a>
				</div>
			{% endif %}


			<section class="register-login-section">

				<article class="subscribe-form display-center left-section">
					<h2>Nous sommes ravis de vous revoir !</h2>


					<div class="login-form">
						<input class="suscribe-input" placeholder="Email" type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>

						<input class="suscribe-input" placeholder="Mot de passe" type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
						<a href="/reset-password" class="reset-password-link">Mot de passe oublié ?</a>


						<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

						<div class="rememberMe-block">
							<input type="checkbox" id="remember_me" name="_remember_me"/>
							<label for="remember_me">Se souvenir de moi</label>
						</div>
						{% if error %}
							<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') | raw }}</div>
						{% endif %}

						<button type="submit" class="nav-button">Me connecter</button>
					</div>


				</article>

				<article class="login-section right-section">
					<div class="login-section-content">
						<h2>Vous n'avez pas encore
							<br>
							de compte ?</h2>
						<p>Inscrivez-vous en quelques minutes !</p>
						<a href="{{path('app_register')}}">
							<span class="nav-button nav-blue-button">
								M'inscrire</span>
						</a>
					</div>

				</article>
			</section>


			{#
																            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
																            See https://symfony.com/doc/current/security/remember_me.html
																
																            <div class="checkbox mb-3">
																                <input type="checkbox" name="_remember_me" id="_remember_me">
																                <label for="_remember_me">Remember me</label>
																            </div>
																        #}


		</form>
	</main>
{% endblock %}

{% block footer %}{% endblock %}
