{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'search-input', 'CarModelsSelection', 'country-input', 'vehiclePhotoDynamicInput', 'adminDashboardStyle']) }}
{% endblock %}

{% block title %}Déposez votre annonce
{% endblock %}

{% block stylesheets %}
	<style>
		/* Conteneur principal */
		body,
		html {
			height: 100%;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
		}

		.content-container {
			width: 80%;
			min-height: 58vh;
			background-color: #ffffff;
			padding: 25px;
			border-radius: 8px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			display: flex;
			flex-direction: column;
			align-items: center;
			margin: auto;
			gap: 30px;
		}

		h1 {
			color: #282F4B;
			text-align: center;
			font-size: clamp(1rem, 3vw, 1.5rem);
		}

		.form-container {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 40px;
			padding-top: 15px;
			align-items: center;
		}

		.form-group {
		}

		label {
			font-weight: bold;
			display: block;
			margin-bottom: 5px;
			color: #333;
		}

		input,
		select,
		textarea {
			width: 100%;
			padding: 10px;
			border: 1px solid #ccc;
			border-radius: 5px;
			font-size: 14px;
		}

		.nav-button,
		.prev,
		.next {
			background-color: #EB8072;
			color: white;
			padding: 10px 20px;
			font-size: 16px;
			border: none;
			border-radius: 5px;
			cursor: pointer;
			transition: background-color 0.3s ease;
			margin-top: 15px;
		}


		.nav-button:hover,
		.prev:hover,
		.next:hover {
			background-color: #d96d61;
		}

		.hidden {
			display: none;
		}

		.steps {
			display: flex;
			justify-content: center;
		}

		.step {
			width: 25px;
			height: 25px;
			margin: 0 5px;
			background-color: #ddd;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: white;
			font-size: 14px;
		}

		.step.active {
			background-color: #EB8072;
		}

		@media(max-width: 768px) {
			.form-container {
				grid-template-columns: 1fr;
			}
		}

		/* POP UP STYLE  */

		.overlay {
			position: fixed;
			top: 0;
			bottom: 0;
			left: 0;
			right: 0;
			background: rgba(0, 0, 0, 0.7);
			transition: opacity 500ms;
			visibility: hidden;
			opacity: 0;
		}
		.overlay:target {
			visibility: visible;
			opacity: 1;
			z-index: 99999;
		}

		.popup {
			margin: 45vh auto;
			padding: 50px 20px;
			background: #fff;
			border-radius: 5px;
			width: 50%;
			position: relative;
			transition: all 2s ease-in-out;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
		}

		.popup .close {
			position: absolute;
			top: 20px;
			right: 30px;
			transition: all 200ms;
			font-size: 30px;
			font-weight: bold;
			text-decoration: none;
			color: #333;
		}
		.popup .close:hover {
			color: rgba(11, 79, 108, 0.575);
		}
		.popup .content {
			max-height: 30%;
			overflow: auto;
			text-align: center;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 10px;
		}

		.popup .content a {
			text-decoration: underline;
		}

		.popup .content a:hover {
			text-decoration: underline;
			font-weight: 500;
		}


		.alert-error {
			list-style-type: none;
			margin-top: 3px;
			font-size: 15px;
			color: red;
		}

		.form-navigation{
			display:flex;
			justify-content: center;
			gap: 20px
		}
	</style>
{% endblock %}

{% block body %}
	<!-- START POP UP -->
	<div id="msg" class="overlay">
		<div class="popup">
			<a class="close" href="#">x</a>
			<div class="content">
				Votre profil doit être vérifié pour pouvoir ajouter un véhicule.
				<br>
				<a href="{{ path('app_user_profile_verify') }}">Vérifier mon profil</a>
			</div>
		</div>
	</div>

	<!-- END POP UP -->

	<section class="admin-dashboard-content">
		<div class="content-container">
			<h1>Déposez votre annonce et louez votre voiture en toute simplicité</h1>
			<!-- Indicateurs de progression -->
			<div class="steps">
				<div class="step active">1</div>
				<div class="step">2</div>
				<div class="step">3</div>
				<div class="step">4</div>
				<div class="step">5</div>
				<div class="step">6</div>
				<div class="step">7</div>
			</div>

			{{ form_start(vehicleForm) }}

			<!-- Étape 1 : Informations du véhicule -->
			<div class="form-step-1">
				<h3>Votre véhicule</h3>
				<div class="form-container">
					<div class="form-group brand-container vehicle-container">
						{{ form_label(vehicleForm.model.brand.name, 'Marque') }}
						{{ form_widget(vehicleForm.model.brand.name, { 'attr': {'data-action': 'brand-input'} }) }}
						<div class="form-error">{{ form_errors(vehicleForm.model.brand.name) }}</div>
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group model-container">
						{{ form_label(vehicleForm.model.name, 'Modèle') }}
						{{ form_widget(vehicleForm.model.name, { 'attr': {'data-action': 'model-input'} }) }}
						<div class="form-error">{{ form_errors(vehicleForm.model.name) }}</div>
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.model.vehicleCategory, { label: 'Type de véhicule' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.color, { label: 'Couleur' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.seats, { label: 'nombre de sièges' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.doors, { label: 'nombre de portes' }) }}
					</div>
				</div>
			</div>

			<!-- Étape 2 : Immatriculation -->
			<div class="form-step-2 hidden">
				<h3>Immatriculation</h3>
				<div class="form-container">
					<div class="form-group">
						{{ form_row(vehicleForm.RegistrationCertificate.certificateNumber, { label: 'Plaque d\'immatriculation' }) }}
					</div>
					<div class="form-group country-container">
					{{ form_label(vehicleForm.RegistrationCertificate.countryOfIssue, 'Pays d\'immatriculation') }}
						{{ form_widget(vehicleForm.RegistrationCertificate.countryOfIssue, { 'attr': {'data-action': 'country-input'} }) }}
						<div class="form-error">
							{{ form_errors(vehicleForm.RegistrationCertificate.countryOfIssue) }}
						</div>
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.RegistrationCertificate.frontImageFile, { label: 'Image recto' }) }}
						<div class="form-error">{{ form_errors(vehicleForm.RegistrationCertificate.frontImageFile) }}</div>
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.RegistrationCertificate.backImageFile, { label: 'Image verso' }) }}
						<div class="form-error">{{ form_errors(vehicleForm.RegistrationCertificate.backImageFile) }}</div>
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.RegistrationCertificate.issueDate, { label: "Date d'immatriculation" }) }}
						<div class="form-error">{{ form_errors(vehicleForm.RegistrationCertificate.issueDate) }}</div>
					</div>
				</div>
			</div>

			<!-- Étape 3 : Caractéristiques techniques -->
			<div class="form-step-3 hidden">
				<h3>Caractéristiques techniques</h3>
				<div class="form-container">
					<div class="form-group">
						{{ form_row(vehicleForm.mileage, { label: 'Kilométrage' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.fuelType, { label: 'Carburant' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.gearboxType, { label: 'Boîte de vitesse' }) }}
					</div>
				</div>
			</div>

			<!-- Étape 4 : Tarification -->
			<div class="form-step-4 hidden">
				<h3>Tarification</h3>
				<div class="form-container">
					<div class="form-group">
						{{ form_row(vehicleForm.pricePerDay, { label: 'Tarif/jour' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.extraMileageRate, { label: 'Prix par km supplémentaire' }) }}
					</div>
				</div>
			</div>

			<!-- Étape 5 : Localisation -->
			<div class="form-step-5 hidden">
				<h3>Localisation</h3>
				<div class="form-container">
					<div class="form-group address-container street-container">
						{{ form_label(vehicleForm.address,'Adresse') }}
						{{ form_widget(vehicleForm.address, { 'attr': {'data-action': 'address-input'} }) }}
						{{ form_errors(vehicleForm.address) }}
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group city-container">
						{{ form_label(vehicleForm.city,'ville') }}
						{{ form_widget(vehicleForm.city, { 'attr': {'data-action': 'city-input'} }) }}
						{{ form_errors(vehicleForm.city) }}
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group postcode-container">
						{{ form_label(vehicleForm.postalCode,'code postal') }}
						{{ form_widget(vehicleForm.postalCode, { 'attr': {'data-action': 'postcode-input'} }) }}
						{{ form_errors(vehicleForm.postalCode) }}
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- Étape 6 : Description -->
			<div class="form-step-6 hidden">
				<h3>Description</h3>
				<div class="form-group">
					{{ form_row(vehicleForm.description, { label: "Description de l'annonce" }) }}
				</div>
			</div>

			<!-- Étape 7 : Photos du véhicule -->
			<div class="form-step-7 hidden">
				<h3>Photos du véhicule</h3>
				<div class="photo-collection">
					{{ form_label(vehicleForm.photos, 'Photos du véhicule (5 minimum)') }}
					{{ form_errors(vehicleForm.photos) }}
					<div class="photo-items">
						{% for photoForm in vehicleForm.photos %}
							<div class="photo-item">
								{{ form_row(photoForm.imageFile) }}

							</div>
						{% endfor %}
					</div>
					<button type="button" class="add-photo-button">Ajouter une photo</button>
					<div class="photo-prototype" data-prototype="{{ form_widget(vehicleForm.photos.vars.prototype)|e('html_attr') }}"></div>
				</div>
			</div>

			<!-- Boutons de navigation -->
			<div class="form-navigation">
				<button type="button" class="prev hidden">Précédent</button>
				<button type="button" class="next">Suivant</button>
				{% if app.user.profile.isVerified is not same as true %}
					<a href="#msg" class="nav-button">Ajouter mon véhicule</a>
				{% else %}
					<button type="submit" class="nav-button hidden submit-button">Ajouter mon véhicule</button>
				{% endif %}
			</div>


			{{ form_end(vehicleForm) }}
		</div>
	</section>

	<script>
		document.addEventListener("DOMContentLoaded", function () {
    const prevButton = document.querySelector('.prev');
    const nextButton = document.querySelector('.next');
    const submitButton = document.querySelector('.submit-button');
    const stepIndicators = document.querySelectorAll('.step');
    const sections = document.querySelectorAll('[class^="form-step"]');
    let currentStep = 0;

    function showStep(index) {
        sections.forEach((section, i) => {
            section.classList.toggle('hidden', i !== index);
        });

        stepIndicators.forEach((indicator, i) => {
            indicator.classList.toggle('active', i <= index);
        });

        // Afficher/Masquer les boutons en fonction de l'étape
        prevButton.classList.toggle('hidden', index === 0);
        nextButton.classList.toggle('hidden', index === sections.length - 1);
        submitButton.classList.toggle('hidden', index !== sections.length - 1);
    }

    function validateCurrentStep() {
        const inputs = sections[currentStep].querySelectorAll('input, select, textarea');
        let isValid = true;

        inputs.forEach(input => {
            const errorMessage = input.parentElement.querySelector('.form-error');
            if (errorMessage) {
                errorMessage.textContent = ''; // Clear previous error
            }

            // Validation spécifique pour chaque champ
            if (input.name.includes('color')) {
                // Vérifie que la couleur est bien un texte
                if (!/^[a-zA-Z\s]+$/.test(input.value)) {
                    errorMessage.textContent = 'Veuillez entrer une couleur valide (texte uniquement).';
                    isValid = false;
                }
            }

            if (!input.checkValidity()) {
                errorMessage.textContent = input.validationMessage || 'Ce champ est obligatoire.';
                isValid = false;
            }
        });

        return isValid;
    }

    prevButton.addEventListener('click', function () {
        if (currentStep > 0) currentStep--;
        showStep(currentStep);
    });

    nextButton.addEventListener('click', function () {
        if (validateCurrentStep() && currentStep < sections.length - 1) {
            currentStep++;
            showStep(currentStep);
        }
    });

    showStep(currentStep);
});

	</script>

	<script type="text/javascript" src="https://www.carqueryapi.com/js/jquery.min.js"></script>
	<script type="text/javascript" src="https://www.carqueryapi.com/js/carquery.0.3.4.js"></script>
{% endblock %}
