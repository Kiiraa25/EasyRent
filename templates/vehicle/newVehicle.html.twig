{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'newVehicleStyle', 'search-input', 'CarModelsSelection', 'country-input', 'vehiclePhotoDynamicInput', 'adminDashboardStyle', 'vehicleNew']) }}
{% endblock %}

{% block title %}Ajouter un véhicule - Easy-Rent
{% endblock %}

{% block meta_description %}
	<meta name="description" content="Ajoutez votre véhicule sur Easy-Rent et commencez à le louer en toute simplicité. Gagnez un revenu supplémentaire en partageant votre voiture avec notre communauté.">

{% endblock %}


{% block body %}
	<!-- START POP UP -->
	<div id="msg" class="overlay">
		<div class="popup">
			<a class="close" href="#">x</a>
			<div class="content">
				Votre profil doit être vérifié pour pouvoir ajouter un véhicule.
				<br>
				<a href="{{ path('app_user_profile_verify') }}">Vérifier mon profil</a>
			</div>
		</div>
	</div>

	<!-- END POP UP -->

	<section class="admin-dashboard-content">
		<div class="content-container">
			<h1>Déposez votre annonce et louez votre voiture en toute simplicité</h1>
			<!-- Indicateurs de progression -->
			<div class="steps">
				<div class="step active">1</div>
				<div class="step">2</div>
				<div class="step">3</div>
				<div class="step">4</div>
				<div class="step">5</div>
				<div class="step">6</div>
				<div class="step">7</div>
			</div>

			{{ form_start(vehicleForm) }}

			<!-- Étape 1 : Informations du véhicule -->
			<div class="form-step-1">
				<h3>Votre véhicule</h3>
				<div class="form-container">
					<div class="form-group brand-container vehicle-container">
						{{ form_label(vehicleForm.model.brand.name, 'Marque') }}
						{{ form_widget(vehicleForm.model.brand.name, { 'attr': {'data-action': 'brand-input'} }) }}
						<div class="form-error">{{ form_errors(vehicleForm.model.brand.name) }}</div>
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group model-container">
						{{ form_label(vehicleForm.model.name, 'Modèle') }}
						{{ form_widget(vehicleForm.model.name, { 'attr': {'data-action': 'model-input'} }) }}
						<div class="form-error">{{ form_errors(vehicleForm.model.name) }}</div>
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.model.vehicleCategory, { label: 'Type de véhicule' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.color, { label: 'Couleur' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.seats, { label: 'nombre de sièges' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.doors, { label: 'nombre de portes' }) }}
					</div>
				</div>
			</div>

			<!-- Étape 2 : Immatriculation -->
			<div class="form-step-2 hidden">
				<h3>Immatriculation</h3>
				<div class="form-container">
					<div class="form-group">
						{{ form_row(vehicleForm.RegistrationCertificate.certificateNumber, { label: 'Plaque d\'immatriculation' }) }}
					</div>
					<div class="form-group country-container">
					{{ form_label(vehicleForm.RegistrationCertificate.countryOfIssue, 'Pays d\'immatriculation') }}
						{{ form_widget(vehicleForm.RegistrationCertificate.countryOfIssue, { 'attr': {'data-action': 'country-input'} }) }}
						<div class="form-error">
							{{ form_errors(vehicleForm.RegistrationCertificate.countryOfIssue) }}
						</div>
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.RegistrationCertificate.frontImageFile, { label: 'Image recto' }) }}
						<div class="form-error">{{ form_errors(vehicleForm.RegistrationCertificate.frontImageFile) }}</div>
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.RegistrationCertificate.backImageFile, { label: 'Image verso' }) }}
						<div class="form-error">{{ form_errors(vehicleForm.RegistrationCertificate.backImageFile) }}</div>
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.RegistrationCertificate.issueDate, { label: "Date d'immatriculation" }) }}
						<div class="form-error">{{ form_errors(vehicleForm.RegistrationCertificate.issueDate) }}</div>
					</div>
				</div>
			</div>

			<!-- Étape 3 : Caractéristiques techniques -->
			<div class="form-step-3 hidden">
				<h3>Caractéristiques techniques</h3>
				<div class="form-container">
					<div class="form-group">
						{{ form_row(vehicleForm.mileage, { label: 'Kilométrage' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.fuelType, { label: 'Carburant' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.gearboxType, { label: 'Boîte de vitesse' }) }}
					</div>
				</div>
			</div>

			<!-- Étape 4 : Tarification -->
			<div class="form-step-4 hidden">
				<h3>Tarification</h3>
				<div class="form-container">
					<div class="form-group">
						{{ form_row(vehicleForm.pricePerDay, { label: 'Tarif/jour' }) }}
					</div>
					<div class="form-group">
						{{ form_row(vehicleForm.extraMileageRate, { label: 'Prix par km supplémentaire' }) }}
					</div>
				</div>
			</div>

			<!-- Étape 5 : Localisation -->
			<div class="form-step-5 hidden">
				<h3>Localisation</h3>
				<div class="form-container">
					<div class="form-group address-container street-container">
						{{ form_label(vehicleForm.address,'Adresse') }}
						{{ form_widget(vehicleForm.address, { 'attr': {'data-action': 'address-input'} }) }}
						{{ form_errors(vehicleForm.address) }}
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group city-container">
						{{ form_label(vehicleForm.city,'ville') }}
						{{ form_widget(vehicleForm.city, { 'attr': {'data-action': 'city-input'} }) }}
						{{ form_errors(vehicleForm.city) }}
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
					<div class="form-group postcode-container">
						{{ form_label(vehicleForm.postalCode,'code postal') }}
						{{ form_widget(vehicleForm.postalCode, { 'attr': {'data-action': 'postcode-input'} }) }}
						{{ form_errors(vehicleForm.postalCode) }}
						<div id="dropdownMenu" class="hidden">
							<ul id="dropdownResults">
								<li>Aucun résultat</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- Étape 6 : Description -->
			<div class="form-step-6 hidden">
				<h3>Description</h3>
				<div class="form-group">
					{{ form_row(vehicleForm.description, { label: "Description de l'annonce" }) }}
				</div>
			</div>

			<!-- Étape 7 : Photos du véhicule -->
			<div class="form-step-7 hidden">
				<h3>Photos du véhicule</h3>
				<div class="photo-collection">
					{{ form_label(vehicleForm.photos, '(5 minimum)') }}
					{{ form_errors(vehicleForm.photos) }}
					<div class="photo-items">
						{% for photoForm in vehicleForm.photos %}
							<div class="photo-item">
								{{ form_row(photoForm.imageFile) }}

							</div>

						{% endfor %}
					</div>
					<button type="button" class="add-photo-button">Ajouter une photo</button>
					<div class="photo-prototype" data-prototype="{{ form_widget(vehicleForm.photos.vars.prototype)|e('html_attr') }}"></div>
				</div>
			</div>

			<!-- Boutons de navigation -->
			<div class="form-navigation">
				<button type="button" class="prev nav-button hidden">Précédent</button>
				<button type="button" class="next nav-button">Suivant</button>
				{% if app.user.profile.isVerified is not same as true %}
					<a href="#msg" class="nav-button submit-button1 hidden">Envoyer</a>
				{% else %}
					<button type="submit" class="nav-button hidden submit-button">Envoyer</button>
				{% endif %}
			</div>


			{{ form_end(vehicleForm) }}
		</div>
	</section>

	
	<script type="text/javascript" src="https://www.carqueryapi.com/js/jquery.min.js"></script>
	<script type="text/javascript" src="https://www.carqueryapi.com/js/carquery.0.3.4.js"></script>
{% endblock %}
