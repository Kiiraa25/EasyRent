{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app','componentsStyle']) }}
{% endblock %}

{% block title %}Détails du véhicule
{% endblock %}

{% block stylesheets %}
	<style>
		.vehicle-container {
			width: 80%;
			background-color: #ffffff;
			border-radius: 8px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			padding: 20px;
			margin-top: 20px;
			max-height: 84vh;
			overflow: auto;
		}

		.vehicle-header {
			display: flex;
			align-items: center;
			border-bottom: 2px solid #FF866F;
			padding-bottom: 15px;
			margin-bottom: 20px;
		}

		.vehicle-picture img {
			border-radius: 8px;
			width: 180px;
			height: 120px;
			object-fit: cover;
			margin-right: 20px;
		}

		.vehicle-info h1 {
			color: #282F4B;
			font-size: 1.8em;
			margin: 0;
		}

		.vehicle-info p {
			color: #666;
			margin: 5px 0;
			font-size: 1.1em;
		}

		.section {
			margin-top: 30px;
		}

		.section h2 {
			color: #282F4B;
			border-bottom: 1px solid #FF866F;
			padding-bottom: 8px;
			margin-bottom: 15px;
			font-size: 1.5em;
		}

		.section-content p {
			color: #333;
			margin: 5px 0;
			font-size: 1.1em;
		}

		.reservation {
			background-color: #f9f9f9;
			padding: 12px;
			border: 1px solid #ddd;
			border-radius: 5px;
			margin-bottom: 10px;
			font-size: 1em;
		}

		/* Boutons cohérents avec les couleurs du site */
		.edit-button,
		.reserve-button,
		.btn {
			display: inline-block;
			padding: 10px 20px;
			background-color: #282F4B; /* Couleur de fond principal */
			color: white;
			text-decoration: none;
			border: none;
			font-size: 16px;
			border-radius: 5px;
			font-weight: bold;
			transition: background-color 0.3s ease;
		}

		.edit-button:hover,
		.reserve-button:hover,
		.btn:hover {
			background-color: #EB8072; /* Couleur de survol */
			cursor: pointer;
		}

		.button-container {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 20px;
			margin-top: 20px;
		}
	</style>
{% endblock %}

{% block content %}
<main>
		<div class="vehicle-container">
			<div class="vehicle-header">
				<div class="vehicle-picture">
					{% if vehicle.photos|length > 0 %}
						{# <img src="{{ asset('/img/vehicles/' ~ vehicle.getPhotos[0].imagePath) }}" alt="Photo du véhicule {{ vehicle.model.name }}"> #}
						<img src="{{ vich_uploader_asset(vehicle.photos[0], 'imageFile') }}" alt="Photo du véhicule">
						<img src="{{ vich_uploader_asset(vehicle.photos[1], 'imageFile') }}" alt="Photo du véhicule">
						<img src="{{ vich_uploader_asset(vehicle.photos[2], 'imageFile') }}" alt="Photo du véhicule">
						<img src="{{ vich_uploader_asset(vehicle.photos[3], 'imageFile') }}" alt="Photo du véhicule">
						<img src="{{ vich_uploader_asset(vehicle.photos[4], 'imageFile') }}" alt="Photo du véhicule">

					{% endif %}
				</div>
				<div class="vehicle-info">
					<h1>{{ vehicle.model.brand.name }}
						{{ vehicle.model.name }}</h1>
					<p>
						<strong>Prix par jour:</strong>
						{{ vehicle.pricePerDay }}
						€</p>
					<p>
						<strong>Adresse:</strong>
						{{ vehicle.address }}</p>
				</div>
			</div>

			<div class="section">
				<h2>Caractéristiques</h2>
				<div class="section-content">
					<p>
						<strong>Couleur:</strong>
						{{ vehicle.color }}</p>
					<p>
						<strong>Kilométrage:</strong>
						{{ vehicle.mileage }}
						km</p>
					<p>
						<strong>Type de carburant:</strong>
						{{ vehicle.fuelType.value }}</p>
					<p>
						<strong>Type de boîte de vitesses:</strong>
						{{ vehicle.gearboxType.value }}</p>
					<p>
						<strong>Portes:</strong>
						{{ vehicle.doors }}</p>
					<p>
						<strong>Sièges:</strong>
						{{ vehicle.seats }}</p>
				</div>
			</div>

			<div class="section">
				<h2>Description</h2>
				<div class="reservation">
					<p>{{ vehicle.description }}</p>
				</div>
			</div>

			<div class="button-container">
				{% if vehicle.owner == app.user %}
					{% if vehicle.status.value != 'archived' %}
					<a href="{{ path('app_vehicle_edit', {'id': vehicle.id}) }}" class="edit-button">Éditer l'annonce</a>
					<a href="{{ path('app_vehicle_delete', {'id': vehicle.id}) }}" class="edit-button">Supprimer l'annonce</a>
					{% endif %}
				{% else %}
					<a href="{{ path('app_rental_new', {'vehicle_id': vehicle.id, 'startDate': startDate|date('Y-m-d'), 'endDate': endDate|date('Y-m-d')}) }}" class="edit-button">Réserver</a>
				{% endif %}
			</div>
		</div>
</main>
{% endblock %}
