{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'componentsStyle']) }}
{% endblock %}

{% block title %}Détails du véhicule - Easy-Rent
{% endblock %}

{% block stylesheets %}
	<style>
		/* Global body style */
		body {
			font-family: "Poppins", sans-serif;
			margin: 0;
			padding: 0;
			background-color: #f9f9f9;
			color: #333;
		}

		.vehicle-container {
			width: 90%;
			max-width: 1200px;
			background-color: white;
			border-radius: 15px;
			box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
			padding: 30px;
			overflow: hidden;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.vehicle-header {
			display: flex;
			flex-direction: column;
			align-items: center;
			margin-bottom: 30px;
			height: 510px;
		}

		.vehicle-picture img {
			max-width: 600px;
			height: 400px;
			object-fit: cover;
			border-radius: 15px;
			margin-bottom: 20px;
			transition: transform 0.3s ease-in-out, box-shadow 0.3s;
		}

		.vehicle-picture img:hover {
			transform: scale(1.05);
			box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
		}

		.thumbnails {
			display: flex;
			gap: 15px;
			justify-content: center;
		}


		.thumbnails img {
			width: 80px;
			height: 80px;
			object-fit: cover;
			cursor: pointer;
			border: 2px solid transparent;
			border-radius: 10px;
			transition: transform 0.3s, border-color 0.3s;
		}

		.thumbnails img:hover,
		.thumbnails img.selected {
			transform: scale(1.1);
			border-color: #EB8072;
		}

		.vehicle-info h1 {
			color: #282F4B;
			font-size: 2em;
			margin: 0;
			text-align: center;
			font-weight: bold;
		}

		.vehicle-info p {
			color: #555;
			margin: 5px 0;
			font-size: 1.2em;
			text-align: center;
		}

		.section {
			margin-top: 60px;
			width: 70%;
		}

		.section h2 {
			color: #282F4B;
			font-size: 1.8em;
			margin-bottom: 20px;
			text-align: center;
			position: relative;
			display: inline-block;
		}

		.section h2::after {
			content: '';
			display: block;
			height: 3px;
			background-color: #FF866F;
			margin: 10px auto 0;
			border-radius: 5px;
		}

		.section-content {
			display:flex;
			justify-content: space-between;
		}
		.section-content p {
			color: #333;
			margin: 10px 0;
			font-size: 1.1em;
			line-height: 1.6;
			text-align: justify;
		}

		.reservation {
			background-color: #f3f3f3;
			padding: 20px;
			border: 1px solid #ddd;
			border-radius: 10px;
			font-size: 1.1em;
			line-height: 1.5;
		}

		.button-container {
			display: flex;
			justify-content: center;
			gap: 20px;
			margin-top: 30px;
		}

		.edit-button,
		.reserve-button {
			padding: 12px 25px;
			background-color: #282F4B;
			color: white;
			border: none;
			border-radius: 30px;
			text-decoration: none;
			font-size: 16px;
			font-weight: bold;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			transition: background-color 0.3s ease, transform 0.2s;
		}

		.edit-button:hover,
		.reserve-button:hover {
			background-color: #EB8072;
			transform: translateY(-3px);
		}

		.edit-button:active,
		.reserve-button:active {
			transform: translateY(0);
		}

		@media screen and(max-width: 768px) {
			.vehicle-container {
				padding: 20px;
			}

			.vehicle-picture img {
				max-height: 250px;
			}

			.thumbnails img {
				width: 60px;
				height: 60px;
			}

			.vehicle-info h1 {
				font-size: 1.5em;
			}

			.vehicle-info p {
				font-size: 1em;
			}
		}
	</style>
{% endblock %}

{% block content %}
	<main>
		<div class="vehicle-container">
			<div class="vehicle-header">
				<div class="vehicle-picture">
					<img id="main-image" src="{{ vich_uploader_asset(vehicle.photos[0], 'imageFile') }}" alt="Photo principale du véhicule">
				</div>

				<div class="thumbnails">
					{% for photo in vehicle.photos %}
						<img src="{{ vich_uploader_asset(photo, 'imageFile') }}" alt="Miniature {{ loop.index }}" class="thumbnail {% if loop.first %}selected{% endif %}" onclick="changeMainImage('{{ vich_uploader_asset(photo, 'imageFile') }}', this)">
					{% endfor %}
				</div>
			</div>

			<div class="vehicle-info">
				<h1>{{ vehicle.model.brand.name }}
					{{ vehicle.model.name }}</h1>
				{# <p>
																																	<strong>Prix par jour:</strong>
																																	{{ vehicle.pricePerDay }}
																																	€</p>
																																<p> #}
				<p>
					{{ vehicle.registrationCertificate.issueDate|date('Y') }}
					-
					{{ vehicle.seats }}
					places -
					{{ vehicle.mileage }}
					km
				</p>

				<p>
					<strong>Adresse:</strong>
					{{ vehicle.address}},
					{{ vehicle.postalCode}},
					{{ vehicle.city}}
				</p>

			</div>

			<div class="section">
				<h2>Caractéristiques</h2>
				<div class="section-content">
					<div>
						<p>
							<strong>Couleur:</strong>
							{{ vehicle.color }}</p>
						<p>
							<strong>Kilométrage:</strong>
							{{ vehicle.mileage }}
							km</p>
						<p>
							<strong>Année d'immatriculation:</strong>
							{{ vehicle.registrationCertificate.issueDate|date('Y') }}</p>
						<p>
							<strong>Type de carburant:</strong>
							{{ vehicle.fuelType.value }}
						</p>
					</div>
					<div>
						<p>
							<strong>Type de boîte de vitesses:</strong>
							{{ vehicle.gearboxType.value }}</p>
						<p>
							<strong>Portes:</strong>
							{{ vehicle.doors }}</p>
						<p>
							<strong>Sièges:</strong>
							{{ vehicle.seats }}</p>
						<p>
							<strong>Tarif par jour:</strong>
							{{ vehicle.pricePerDay }}
						</p>
					</div>
				</div>
			</div>


			<div class="section">
				<h2>Description</h2>
				<div class="reservation">
					<p>{{ vehicle.description }}</p>
				</div>
			</div>

			<div class="button-container">
				{% if vehicle.owner == app.user %}
					{% if vehicle.status.value != 'archived' %}
						<a href="{{ path('app_vehicle_edit', {'id': vehicle.id}) }}" class="edit-button">Éditer l'annonce</a>
						<a href="{{ path('app_vehicle_delete', {'id': vehicle.id}) }}" class="edit-button">Supprimer l'annonce</a>
					{% endif %}
				{% else %}
					<a href="{{ path('app_rental_new', {'vehicle_id': vehicle.id, 'startDate': startDate|date('Y-m-d'), 'endDate': endDate|date('Y-m-d')}) }}" class="reserve-button">Réserver</a>
				{% endif %}
			</div>
		</div>
	</main>

	<script>
		function changeMainImage(imageUrl, thumbnail) {
const mainImage = document.getElementById('main-image');
mainImage.src = imageUrl;

// Réinitialiser la sélection des miniatures
document.querySelectorAll('.thumbnail').forEach(thumbnail => {
thumbnail.classList.remove('selected');
});

// Ajouter la classe sélectionnée à la miniature active
thumbnail.classList.add('selected');
}
	</script>
{% endblock %}
