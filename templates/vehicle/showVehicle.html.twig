{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'componentsStyle', 'showVehicleStyle', 'showVehicleThumbnailImage']) }}
{% endblock %}

{% block title %}Détails du véhicule - Easy-Rent
{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
	<main>
		<div class="vehicle-container">
			<div class="vehicle-header">
				<div class="vehicle-picture">
					<img id="main-image" src="{{ vich_uploader_asset(vehicle.photos[0], 'imageFile') }}" alt="Photo principale du véhicule">
				</div>

				<div class="thumbnails">
					{% for photo in vehicle.photos %}
						<img src="{{ vich_uploader_asset(photo, 'imageFile') }}" alt="Miniature {{ loop.index }}" class="thumbnail {% if loop.first %}selected{% endif %}" onclick="changeMainImage('{{ vich_uploader_asset(photo, 'imageFile') }}', this)">
					{% endfor %}
				</div>
			</div>

			<div class="vehicle-info">
				<h1>{{ vehicle.model.brand.name }}
					{{ vehicle.model.name }}</h1>
				{{ vehicle.registrationCertificate.issueDate|date('Y') }}
				-
				{{ vehicle.seats }}
				places -
				{{ vehicle.mileage }}
				km
			</p>

		</div>


		<div class="section">
			<h2>Caractéristiques</h2>
			<div class="section-content">
				<div>
					<p>
						<strong>Couleur:</strong>
						{{ vehicle.color }}</p>
					<p>
						<strong>Kilométrage:</strong>
						{{ vehicle.mileage }}
						km</p>
					<p>
						<strong>Année d'immatriculation:</strong>
						{{ vehicle.registrationCertificate.issueDate|date('Y') }}</p>
					<p>
						<strong>Type de carburant:</strong>
						{{ vehicle.fuelType.value }}
					</p>
				</div>
				<div>
					<p>
						<strong>Type de boîte de vitesses:</strong>
						{{ vehicle.gearboxType.value }}</p>
					<p>
						<strong>Portes:</strong>
						{{ vehicle.doors }}</p>
					<p>
						<strong>Sièges:</strong>
						{{ vehicle.seats }}</p>
					<p>
						<strong>Tarif par jour:</strong>
						{{ vehicle.pricePerDay }}
					</p>
				</div>
			</div>
		</div>

		<div class="section">
			<h2>Addresse</h2>
			<p></p>
			<p>

				{{ vehicle.address}},<br>
				{{ vehicle.postalCode}},
				{{ vehicle.city}}
			</p>
		</p>
		<div class="section">
			<h2>Description</h2>
			<div class="reservation">
				<p>{{ vehicle.description }}</p>
			</div>
		</div>

		<div class="button-container">
			{% if vehicle.owner == app.user %}
				{% if vehicle.status.value != 'archived' %}
					<a href="{{ path('app_vehicle_edit', {'id': vehicle.id}) }}" class="edit-button">Éditer</a>
					<a href="{{ path('app_vehicle_delete', {'id': vehicle.id}) }}" class="edit-button">Supprimer</a>
				{% endif %}
			{% else %}
				<a href="{{ path('app_rental_new', {'vehicle_id': vehicle.id, 'startDate': startDate|date('Y-m-d'), 'endDate': endDate|date('Y-m-d')}) }}" class="reserve-button">Réserver</a>
			{% endif %}
		</div>
	</div>
</div>
</main>

<script>

function changeMainImage(imageUrl, thumbnail) {
        const mainImage = document.getElementById('main-image');
        mainImage.src = imageUrl;

        // Réinitialiser la sélection des miniatures
        document.querySelectorAll('.thumbnail').forEach(thumbnail => {
            thumbnail.classList.remove('selected');
        });

        // Ajouter la classe sélectionnée à la miniature active
        thumbnail.classList.add('selected');
    }
	
	</script>

{% endblock %}
