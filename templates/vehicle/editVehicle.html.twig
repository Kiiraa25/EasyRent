{% extends 'dashBoard/base.html.twig' %}

{% block importmap %}
	{{ parent() }}
	{{ importmap(['componentsStyle']) }}
{% endblock %}

{% block title %}Modifier le véhicule - Easy-Rent
{% endblock %}

{% block stylesheets %}
	<style>
		/* Conteneur principal */

		@media screen and (max-width: 768px) {
			.sidebar {
				display: none !important;
			}

			
			.admin-dashboard-content {
				margin: auto;
				max-width: 90%;
				padding: 0;
				height: calc(100vh - 126px) !important;
				overflow: auto;
			}

			.container {
				margin: 20px !important;
			}
			

		}

		
	</style>
{% endblock %}

{% block content %}
<section class="admin-dashboard-content">
	<h1 class="dashboard-title">Modifier les informations du véhicule</h1>


	{{ form_start(form) }}

	<!-- Section Tarification -->
	<div class="tarification">
		{{ form_row(form.pricePerDay, { label: 'Tarif/jour' }) }}
		{{ form_row(form.extraMileageRate, { label: 'Prix par km supplémentaire' }) }}
	</div>

	<!-- Section Adresse -->
	<div class="adresse">
		{{ form_row(form.address, { label: 'Adresse' }) }}
		{{ form_row(form.postalCode, { label: 'Code postal' }) }}
		{{ form_row(form.city, { label: 'Ville' }) }}
	</div>

	<!-- Section Description -->
	<div class="description">
		{{ form_row(form.description, { label: 'Description de l\'annonce' }) }}
			</div>
		

		<div class="form-submit-block">
			<a href="{{ path('app_user_vehicles', { 'id': vehicle.id }) }}" class="back-link">Retour aux détails du véhicule</a>
			<button type="submit" class="nav-button" onclick="return confirm('Êtes-vous sûr de vouloir mettre à jour les informations de ce véhicule ?');">Modifier</button>
		</div>

		{{ form_end(form) }}
     
</section>
{% endblock %}
