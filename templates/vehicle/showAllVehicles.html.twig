{% extends 'base.html.twig' %}


{% block javascripts %}
	{% block importmap %}
		{{ importmap(['app', 'vehicles-search-input', 'geolocation', 'showAllVehiclesStyle']) }}
	{% endblock %}

	<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
{% endblock %}


{% block title %}Rechercher un véhicule - Easy-Rent
{% endblock %}

{% block meta_description %}
	<meta name="description" content="Trouvez la voiture idéale avec Easy-Rent. Recherchez et réservez en quelques clics parmi des citadines, SUV, utilitaires et plus, disponibles près de chez vous.">

{% endblock %}

{% block stylesheets %}

	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

{% endblock %}

{% block body %}
	<main class="all-vehicles-container">

		{% if is_mobile %}
			<div class="search-header">

				{{ form_start(searchForm, {'attr': {'id': 'searchForm'} }) }}

				<div
					class="search-header-input-mobile">
					<!-- Input de recherche -->
					<div class="form-group search-container">
						{{ form_label(searchForm.search) }}
						{{ form_widget(searchForm.search, {'attr': {'class': 'search-input search', 'data-action': 'search-input', 'aria-label': 'Saisir une ville'}}) }}
						{{ form_errors(searchForm.search) }}
					</div>

					<!-- Inputs pour les dates -->
					<div class="date-container-mobile">
						<div class="form-group">
							{{ form_label(searchForm.startDate) }}
							{{ form_widget(searchForm.startDate, {'attr': {'class': 'search-input, filter-btn', 'aria-label': 'Date de début de location souhaitée'}}) }}
							{{ form_errors(searchForm.startDate) }}
						</div>
						<div class="form-group">
							{{ form_label(searchForm.endDate) }}
							{{ form_widget(searchForm.endDate, {'attr': {'class': 'search-input, filter-btn', 'aria-label': 'Date de fin de location souhaitée'}}) }}
							{{ form_errors(searchForm.endDate) }}
						</div>

						<!-- Bouton filtre -->
						<button type="button" class="filter-btn" id="openFiltersMobile">Filtrer</button>
					</div>


					<!-- Pop-up des filtres -->
					<div id="filtersPopupMobile" class="filters-popup-mobile hidden-mobile">
						<div class="filters-content-mobile">
							<button type="button" id="closeFiltersMobile" class="close-filters-btn-mobile">X</button>
							<div class="form-group">
								{{ form_label(searchForm.totalPrice) }}
								{{ form_widget(searchForm.totalPrice, {'attr': {'class': 'filter-btn search-input total-price', 'aria-label': 'Filtrer par prix total souhaité'}}) }}
								{{ form_errors(searchForm.totalPrice) }}
							</div>

							<div class="form-group">
								{{ form_label(searchForm.vehicleCategory) }}
								{{ form_widget(searchForm.vehicleCategory, {'attr': {'class': 'filter-btn', 'aria-label': 'Filtrer par type de véhicule souhaité'}}) }}
								{{ form_errors(searchForm.vehicleCategory) }}
							</div>
							<div class="form-group">
								{{ form_label(searchForm.gearboxType) }}
								{{ form_widget(searchForm.gearboxType, {'attr': {'class': 'filter-btn', 'aria-label': 'Filtrer par type de boite de vitesse souhaité'}}) }}
								{{ form_errors(searchForm.gearboxType) }}
							</div>

							<div class="form-group">
								{{ form_label(searchForm.fuelType) }}
								{{ form_widget(searchForm.fuelType, {'attr': {'class': 'filter-btn', 'aria-label': 'Filtrer par type de carburant souhaité'}}) }}
								{{ form_errors(searchForm.fuelType) }}
							</div>
						</div>
					</div>
				</div>
			</div>

			{{ form_end(searchForm) }}
		</div>
	{% else %}

		<div class="search-header">
			{{ form_start(searchForm, {'attr': {'id': 'searchForm'} }) }}
			<div class="search-header-input">

				<div class="form-group search-container">
					{{ form_label(searchForm.search) }}
					{{ form_widget(searchForm.search, {'attr': {'class': 'search-input search', 'data-action': 'search-input', 'aria-label': 'Saisir une ville'}}) }}
					{{ form_errors(searchForm.search) }}
					<div id="dropdownMenu" class="hidden">
						<ul id="dropdownResults">
							<li>Aucun résultat</li>
						</ul>
					</div>
					{% set displayed_messages = [] %}

					{% for type, messages in app.flashes %}
						{% if type == 'search-error' %}
							{% for message in messages %}
								{% if message not in displayed_messages %}
									<div class="alert alert-{{ type }}">
										{{ message }}
									</div>
									{% set displayed_messages = displayed_messages | merge([message]) %}
								{% endif %}
							{% endfor %}
						{% endif %}
					{% endfor %}


				</div>
				{# <input type="text" placeholder="Adresse précise, gare, métro..." class="search-input"> #}
				<div class="date-container">
					<div class="form-group">
						{{ form_label(searchForm.startDate) }}
						{{ form_widget(searchForm.startDate, {'attr': {'class': 'search-input, filter-btn', 'aria-label': 'Date de début de location souhaitée'}}) }}
						{{ form_errors(searchForm.startDate) }}
					</div>
					<div class="form-group">
						{{ form_label(searchForm.endDate) }}
						{{ form_widget(searchForm.endDate, {'attr': {'class': 'search-input, filter-btn', 'aria-label': 'Date de fin de location souhaitée'}}) }}
						{{ form_errors(searchForm.endDate) }}
					</div>
					{# <input type="date" placeholder="début" class="search-input">
																																																																																																																																																		<input type="date" placeholder="fin" class="search-input"> #}
				</div>
			</div>


			<div class="filters">
				<div class="form-group">
					{{ form_label(searchForm.totalPrice) }}
					{{ form_widget(searchForm.totalPrice, {'attr': {'class': 'filter-btn search-input total-price', 'aria-label': 'Filtrer par prix total souhaité'}}) }}
					{{ form_errors(searchForm.totalPrice) }}
				</div>
				<div class="form-group">
					{{ form_label(searchForm.vehicleCategory) }}
					{{ form_widget(searchForm.vehicleCategory, {'attr': {'class': 'filter-btn', 'aria-label': 'Filtrer par type de véhicule souhaité'}}) }}
					{{ form_errors(searchForm.vehicleCategory) }}
				</div>
				<div class="form-group">
					{{ form_label(searchForm.gearboxType) }}
					{{ form_widget(searchForm.gearboxType, {'attr': {'class': 'filter-btn', 'aria-label': 'Filtrer par type de boite de vitesse souhaité'}}) }}
					{{ form_errors(searchForm.gearboxType) }}
				</div>

				<div class="form-group">
					{{ form_label(searchForm.fuelType) }}
					{{ form_widget(searchForm.fuelType, {'attr': {'class': 'filter-btn', 'aria-label': 'Filtrer par type de carburant souhaité'}}) }}
					{{ form_errors(searchForm.fuelType) }}
				</div>
			</div>

			{{ form_end(searchForm) }}
		</div>
	{% endif %}


	<div
		class="main-container">
		<!-- Left-side: Vehicle List -->
		<div class="vehicle-list">
			{% if vehicles is empty %}
				<p class="no-vehicles">Il n'y a aucun véhicule disponible</p>
			{% else %}
				{% for vehicle in vehicles %}


					<a
						href="{{ path('app_vehicle_show', { 'id': vehicle.id, 'startDate': startDate|date('Y-m-d'), 'endDate': endDate|date('Y-m-d') }) }}" class="vehicle-item" , 'aria-label' : "Cliquer sur un véhicule pour afficher la page d'annonce">
						<!-- Placeholder for vehicle image -->

						{% if vehicle.photos|length > 0 %}

							<img class="vehicle-image" src="{{ vich_uploader_asset(vehicle.photos[0], 'imageFile') }}" alt="Photo du véhicule">

						{% endif %}


						<!-- Vehicle info section -->
						<div class="vehicle-info">

							<h3>{{ vehicle.model.brand.name }}
								{{ vehicle.model.name }}</h3>

							{# <div class="vehicle-rating"><span class="stars">★★★★★</span> 
																																																					<!-- Static stars for now -->
																																																					<span>(22 avis)</span> 
																																																				</div> #}

							<hr>
							<div class="vehicle-details">
								<div>
									<span><img src="{{asset('/img/icons/seats.svg')}}" alt="">
										{{vehicle.seats}}
										places</span>
									<span><img src="{{asset('/img/icons/doors.svg')}}" alt="">
										{{vehicle.doors}}</span>
								</div>
								<div>
									<span><img src="{{asset('/img/icons/gearbox.svg')}}" alt="">
										{{vehicle.gearBoxType.value}}</span>
									<span><img src="{{asset('/img/icons/fueltype.svg')}}" alt="">
										{{vehicle.fuelType.value}}</span>
								</div>
							</div>
							<div class="bottom-infos">
								<strong><img src="{{asset('/img/icons/city.svg')}}" alt="">{{ vehicle.city }}</strong>

								<!-- Price per day -->
								<div class="vehicle-price">
									<span>{{ vehicle.pricePerDay ?? 0}}</span>
									<p>€ / jour</p>
								</div>

							</div>


						</div>


					</a>

				{% endfor %}
			{% endif %}
		</div>

		<!-- Right-side: Blue Placeholder -->
		<div class="blue-box" id="map" , 'aria-label' : 'Carte affichant les véhicules recherchés'>
			<p>Placeholder for map or other content</p>
		</div>
	</div>
</main>

<script>

	// Fonction pour soumettre automatiquement le formulaire lorsque les champs sont modifiés
document.querySelectorAll('.filter-btn').forEach(function (element) {
element.addEventListener('change', function () {
document.getElementById('searchForm').submit();
});
});


// Fonction pour soumettre le formulaire quand la touche "Entrée" est pressée
document.querySelectorAll('.search-input').forEach(function (element) {
element.addEventListener('keypress', function (e) {
if (e.key === 'Enter') { // Si la touche "Entrée" est pressée
e.preventDefault(); // Empêche l'action par défaut
document.getElementById('searchForm').submit(); // Soumettre le formulaire
}
});
});


// Code pour afficher la carte et les markers dans la page recherche de véhicules

let vehicleMarkers = {{ vehicleMarkers|json_encode|raw }};
let latitude = {{ latitude }};
let longitude = {{ longitude }};

// Initialiser la carte avec les coordonnées de la ville recherchée
let map = L.map('map').setView([
latitude, longitude
], 13);

L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
maxZoom: 19,
attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
}).addTo(map);


var coloredIcon = L.icon({
iconUrl: "{{ asset('img/icons/leaflet-icon-marker.png') }}", // Chemin vers l'image colorée de l'icône
iconAnchor: [
12, 41
], // Point d'ancrage
popupAnchor: [0, -41] // Position du popup par rapport à l'icône
});

// Afficher les markers sur la map
vehicleMarkers.forEach(function (vehicle) {
let marker = L.marker([
vehicle.latitude, vehicle.longitude
], {icon: coloredIcon}).addTo(map);

// Ajouter un pop up pour chaque marker
marker.bindPopup(`
        <strong>${vehicle.brand} ${vehicle.model}</strong><br>
        City: ${vehicle.city}<br>
        Prix par jour: €${
vehicle.pricePerDay
}
    `);
});

// Met à jour l'URL sans recharger la page
const params = "{{ queryString }}";
const newUrl = `${
window.location.origin
}${
window.location.pathname
}?${params}`;
window.history.replaceState({}, '', newUrl);


document.getElementById('openFiltersMobile').addEventListener('click', function () {
document.getElementById('filtersPopupMobile').classList.remove('hidden-mobile');
});

document.getElementById('closeFiltersMobile').addEventListener('click', function () {
document.getElementById('filtersPopupMobile').classList.add('hidden-mobile');
});
</script>{% endblock %}{% block footer %}{% endblock %}
