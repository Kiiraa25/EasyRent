{% extends 'base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'registerStyle', 'componentsStyle']) }}
{% endblock %}

{% block title %}Créer un compte - Easy-Rent
{% endblock %}

{% block meta_description %}
	<meta name="description" content="Inscrivez-vous sur Easy-Rent et rejoignez notre communauté. Louez une voiture en quelques clics ou mettez votre véhicule en location dès aujourd'hui. Simple et sécurisé !">

{% endblock %}

{% block body %}


	<main>
		<section class="register-login-section">
			{% if not is_mobile %}

				<article class="login-section left-section">
					<div class="login-section-content">
						<h2>Vous avez déja un
							<br>
							compte ?</h2>
						<p>Connectez-vous maintenant !</p>
						<a href="{{path('app_login')}}">
							<button class="nav-button nav-blue-button">
								Me connecter</button>
						</a>
					</div>

				</article>
			{% endif %}

			<article class="subscribe-form display-center right-section">
				<h2>Créer un compte</h2>

				{{ form_errors(registrationForm) }}

				{{ form_start(registrationForm) }}

				<div>
					{{ form_label(registrationForm.profile.lastName) }}
					{{ form_widget(registrationForm.profile.lastName) }}
					<div class="form-error">{{ form_errors(registrationForm.profile.lastName) }}</div>
				</div>

				<div>
					{{ form_label(registrationForm.profile.firstName) }}
					{{ form_widget(registrationForm.profile.firstName) }}
					<div class="form-error">{{ form_errors(registrationForm.profile.firstName) }}</div>
				</div>

				<div>
					{{ form_label(registrationForm.profile.birthDate) }}
					{{ form_widget(registrationForm.profile.birthDate) }}
					<div class="form-error">{{ form_errors(registrationForm.profile.birthDate) }}</div>
				</div>

				<div>
					{{ form_label(registrationForm.email) }}
					{{ form_widget(registrationForm.email) }}
					<div class="form-error">{{ form_errors(registrationForm.email) }}</div>
				</div>

				<div class="password-container">
					{{ form_label(registrationForm.plainPassword.first) }}
					{{ form_widget(registrationForm.plainPassword.first) }}
					<div class="form-error">{{ form_errors(registrationForm.plainPassword.first) }}</div>
					<span class="toggle-password" onclick="togglePassword('registration_form_plainPassword_first')">
						<i class="fas fa-eye" aria-label="Afficher le mot de passe"></i>
					</span>
				</div>

				<div class="password-container">
					{{ form_label(registrationForm.plainPassword.second) }}
					{{ form_widget(registrationForm.plainPassword.second) }}
					<div class="form-error">{{ form_errors(registrationForm.plainPassword.second) }}</div>
					<span class="toggle-password" onclick="togglePassword('registration_form_plainPassword_second')">
						<i class="fas fa-eye" aria-label="Afficher le mot de passe"></i>
					</span>
				</div>

				{% for type, messages in app.flashes %}
					{% if type == 'register-error' %}
						{% for message in messages %}
							<div class="alert alert-register-error">
								{{ message }}
							</div>
						{% endfor %}
					{% endif %}
				{% endfor %}


				<div class="agree-terms">
					{{ form_widget(registrationForm.agreeTerms) }}
					{{ form_label(registrationForm.agreeTerms) }}
					<div class="form-error">{{ form_errors(registrationForm.agreeTerms) }}</div>
				</div>
				{% for flash_error in app.flashes('verify_email_error') %}
					<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
				{% endfor %}

				<button type="submit" class="nav-button">M'inscrire</button>
				{{ form_end(registrationForm) }}
			</article>


		</section>

	</main>
	<script>
		function togglePassword(fieldId) {
const passwordField = document.getElementById(fieldId);
if (passwordField) { // Vérifie que l'élément existe
passwordField.type = passwordField.type === 'password' ? 'text' : 'password';
} else {
console.error (`Element with ID "${fieldId}" not found.`);
}
}
	</script>
{% endblock %}

{% block footer %}{% endblock %}
