{% extends 'dashBoard/dashBoardBase.html.twig' %}

{% block importmap %}
	{{ importmap(['app']) }}
{% endblock %}

{% block title %}Hello UserProfileController!
{% endblock %}

{% block body %}

	<main>

		<div class="user-icon">
			{% if app.user.profile.picture is not null %}

				<img src="{{ vich_uploader_asset(app.user.profile, 'imageFile') }}" alt=""></div>

		{% else %}
			<img width="200px" src="{{ asset('/img/default-user-icon.png') }}" alt=""></div>

	{% endif %}

	<h1>{{ user.profile.firstName }}
		{{ user.profile.lastName }}</h1>

	<br><br>

	<p>
		<strong>Description:</strong>
		{{ userProfile.description}}</p>
	<p></p>
	<p>
		<strong>Email:</strong>
		{{ user.email }}</p>
	<p>
		<strong>Date de Naissance:</strong>
		{{ userProfile.birthDate|date('d/m/Y') }}</p>
	<p>
		<strong>Adresse:</strong>
		{{ userProfile.address }}</p>
	<p>
		<strong>Code Postal:</strong>
		{{ userProfile.postalCode }}</p>
	<p>
		<strong>Ville:</strong>
		{{ userProfile.city }}</p>
	<p>
		<strong>Téléphone:</strong>
		{{ userProfile.phone }}</p>
	<p>
		<strong>Note:</strong>
		{{ userProfile.rating }}</p>



		<p>Avis récents</p>


</main>{% endblock %}
