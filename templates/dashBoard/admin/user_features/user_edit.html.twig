{% extends 'dashBoard/base.html.twig' %}

{% block title %}Éditer l'utilisateur{% endblock %}

{% block stylesheets %}
    <style>
        /* Global styles */
        body {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        h1 {
            color: #282F4B;
            text-align: center;
        }

        /* Form container */
        .form-container {
            width: 60%;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px 40px;
            margin-top: 20px;
        }

        /* Form elements */
        label {
            color: #282F4B;
            font-weight: bold;
            margin-top: 15px;
            display: inline-block;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            margin: 8px 0 16px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .form-control:focus {
            border-color: #FF866F;
            outline: none;
            box-shadow: 0 0 4px rgba(255, 134, 111, 0.4);
        }

        .btn-submit {
            display: block;
            width: 100%;
            padding: 10px;
            background-color: #FF866F;
            color: #ffffff;
            border: none;
            border-radius: 4px;
            font-size: 1em;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s ease;
            text-align: center;
            margin-top: 20px;
        }

        .btn-submit:hover {
            background-color: #e67564;
        }

        .back-link {
            display: inline-block;
            margin-top: 15px;
            color: #282F4B;
            text-decoration: none;
            font-weight: bold;
        }

        .back-link:hover {
            color: #FF866F;
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Éditer l'utilisateur</h1>

    <div class="form-container">
        {{ form_start(form, {'attr': {'onsubmit': 'return confirmUpdate()'}}) }}

        {{ form_label(form.roles, 'Rôles') }}
        {{ form_widget(form.roles, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.profile.address, 'Adresse') }}
        {{ form_widget(form.profile.address, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.profile.postalCode, 'Code postal') }}
        {{ form_widget(form.profile.postalCode, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.profile.city, 'Ville') }}
        {{ form_widget(form.profile.city, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.profile.country, 'Pays') }}
        {{ form_widget(form.profile.country, {'attr': {'class': 'form-control'}}) }}

        {{ form_label(form.profile.phone, 'Numero de téléphone') }}
        {{ form_widget(form.profile.phone, {'attr': {'class': 'form-control'}}) }}

        <button type="submit" class="btn-submit">Mettre à jour</button>

        {{ form_end(form) }}

        <a href="{{ path('app_admin_users') }}" class="back-link">Retour à la liste des utilisateurs</a>
    </div>

    <script>
        function confirmUpdate() {
            return confirm("Êtes-vous sûr de vouloir mettre à jour les informations de cet utilisateur ?");
        }
    </script>
{% endblock %}
