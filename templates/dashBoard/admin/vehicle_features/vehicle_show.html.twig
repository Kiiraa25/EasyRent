{% extends 'dashBoard/base.html.twig' %}

{% block importmap %}
	{{ parent() }}
	{{ importmap(['componentsStyle']) }}

{% endblock %}


{% block title %}Détails du véhicule - Easy-Rent
{% endblock %}

{% block stylesheets %}
	<style>
		.vehicle-container {
			width: 90%;
			background-color: #ffffff;
			border-radius: 8px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			padding: 20px;
			margin-top: 20px;
            max-height: 84vh;
            overflow: auto;
		}

		.vehicle-header {
			display: flex;
			align-items: center;
			border-bottom: 2px solid #FF866F;
			padding-bottom: 15px;
			margin-bottom: 20px;
		}

		.vehicle-picture img {
			border-radius: 8px;
			width: 180px;
			height: 120px;
			object-fit: cover;
			margin-right: 20px;
		}

		.vehicle-info h1 {
			color: #282F4B;
			font-size: 1.8em;
			margin: 0;
		}

		.vehicle-info p {
			color: #666;
			margin: 5px 0;
			font-size: 1.1em;
		}

		.section {
			margin-top: 30px;
		}

		.section h2 {
			color: #282F4B;
			border-bottom: 1px solid #FF866F;
			padding-bottom: 8px;
			margin-bottom: 15px;
			font-size: 1.5em;
		}

		.section-content p {
			color: #333;
			margin: 5px 0;
			font-size: 1.1em;
		}

		.reservation,
		.review {
			background-color: #f9f9f9;
			padding: 12px;
			border: 1px solid #ddd;
			border-radius: 5px;
			margin-bottom: 10px;
			font-size: 1em;
		}
	</style>
{% endblock %}

{% block content %}
	<section class="admin-dashboard-content">
		<div class="vehicle-container">
			<div class="vehicle-header">
				<div class="vehicle-picture">
					{% if vehicle.photos|length > 0 %}
						<img src="{{ asset('/img/vehicles/' ~ vehicle.getPhotos[0].imagePath) }}" alt="Photo du véhicule {{ vehicle.model.name }}">
					{% endif %}
				</div>
				<div class="vehicle-info">
					<h1>{{ vehicle.model.brand.name }}
						{{ vehicle.model.name }}</h1>
					<p>
						<strong>Prix par jour:</strong>
						{{ vehicle.pricePerDay }}
						€</p>
					<p>
						<strong>Status:</strong>
						{{ vehicle.status.value }}</p>
				</div>
			</div>

			<div class="section">
				<h2>Caractéristiques</h2>
				<div class="section-content">
					<p>
						<strong>Couleur:</strong>
						{{ vehicle.color }}</p>
					<p>
						<strong>Kilométrage:</strong>
						{{ vehicle.mileage }}
						km</p>
					<p>
						<strong>Type de carburant:</strong>
						{{ vehicle.fuelType.value }}</p>
					<p>
						<strong>Type de boîte de vitesses:</strong>
						{{ vehicle.gearboxType.value }}</p>
					<p>
						<strong>Portes:</strong>
						{{ vehicle.doors }}</p>
					<p>
						<strong>Sièges:</strong>
						{{ vehicle.seats }}</p>
				</div>
			</div>

			<div class="section">
				<h2>Réservations</h2>
				<div class="section-content">
					{% for rental in rentals %}
						<div class="reservation">
							<p>
								<strong>Client:</strong>
								{{ rental.renter.profile.firstName }}
								{{ rental.renter.profile.lastName }}</p>
							<p>
								<strong>Du:</strong>
								{{ rental.startDate|date('d/m/Y') }}
								<strong>au:</strong>
								{{ rental.endDate|date('d/m/Y') }}</p>
							<p>
								<strong>Status:</strong>
								{{ rental.status.value }}</p>
						</div>
					{% else %}
						<p>Aucune réservation pour ce véhicule.</p>
					{% endfor %}
				</div>
			</div>

			<div class="section">
				<h2>Avis Reçus</h2>
				<div class="section-content">
					{% for review in reviews %}
						<div class="review">
							<p>
								<strong>Par:</strong>
								{{ review.reviewer.profile.firstName }}
								{{ review.reviewer.profile.lastName }}</p>
							<p>
								<strong>Commentaire:</strong>
								{{ review.comment }}</p>
							<p>
								<strong>Note:</strong>
								{{ review.rating }}
								/ 5</p>
						</div>
					{% else %}
						<p>Aucun avis pour ce véhicule.</p>
					{% endfor %}
				</div>
			</div>
		</div>
	<div class="form-submit-block">
			<a href="{{ path('app_admin_vehicles') }}" class="back-link">Retour à la liste des véhicules</a>
		</div>        </section>
	{% endblock %}
