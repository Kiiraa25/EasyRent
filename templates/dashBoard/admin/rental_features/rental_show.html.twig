{% extends 'dashBoard/base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'componentsStyle']) }}

{% endblock %}

{% block title %}Détails de la location - Easy-Rent
{% endblock %}

{% block stylesheets %}
	<style>
		.rental-container {
			width: 90%;
			background-color: #ffffff;
			border-radius: 8px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			padding: 20px;
			margin: auto;
		}

		.rental-header {
			display: flex;
			align-items: center;
			border-bottom: 2px solid #FF866F;
			padding-bottom: 15px;
			margin-bottom: 20px;
		}

		.vehicle-info h1 {
			color: #282F4B;
			font-size: 1.8em;
			margin: 0;
		}

		.vehicle-info p {
			color: #666;
			margin: 5px 0;
			font-size: 1.1em;
		}

		.section {
			margin-top: 30px;
		}

		.section h2 {
			color: #282F4B;
			border-bottom: 1px solid #FF866F;
			padding-bottom: 8px;
			margin-bottom: 15px;
			font-size: 1.5em;
		}

		.section-content p {
			color: #333;
			margin: 5px 0;
			font-size: 1.1em;
		}
	</style>
{% endblock %}

{% block content %}
	<section class="admin-dashboard-content">
		<div class="rental-container">

			<div class="rental-header">
				<div class="vehicle-info">
					<h1 class="dashboard-title">Location de
						{{ rental.vehicle.model.brand.name }}
						{{ rental.vehicle.model.name }}</h1>
					<p>
						<strong>Client:</strong>
						{{ rental.renter.profile.firstName }}
						{{ rental.renter.profile.lastName }}</p>
					<p>
						<strong>Dates:</strong>
						du
						{{ rental.startDate|date('d/m/Y') }}
						au
						{{ rental.endDate|date('d/m/Y') }}</p>
					<p>
						<strong>Statut:</strong>
						{{ rental.status.value }}</p>
					<p>
						<strong>Prix total:</strong>
						{{ rental.totalPrice }}
						€</p>
				</div>
			</div>

			<div class="section">
				<h2>Détails de la location</h2>
				<div class="section-content">
					<p>
						<strong>Méthode de paiement:</strong>
						{{ rental.paymentMethod.value }}</p>
					<p>
						<strong>Limite de kilométrage:</strong>
						{{ rental.mileageLimit }}
						km</p>
					<p>
						<strong>Créé le:</strong>
						{{ rental.createdAt|date('d/m/Y H:i') }}</p>
					<p>
						<strong>Dernière mise à jour:</strong>
						{{ rental.updatedAt|date('d/m/Y H:i') }}</p>
				</div>
			</div>

			<div class="section">
				<h2>Annulation</h2>
				<div class="section-content">
					{% if rental.status.value == 'ANNULEE' %}
						<p>
							<strong>Raison de l'annulation:</strong>
							{{ rental.cancellationReason }}</p>
						<p>
							<strong>Annulé par:</strong>
							{{ rental.cancelledBy.value }}</p>
					{% else %}
						<p>Cette location n'a pas été annulée.</p>
					{% endif %}
				</div>
			</div>
		</div>
		<div class="form-submit-block">
			<a href="{{ path('app_admin_rentals') }}" class="back-link">Retour à la liste des locations</a>
		</div>
	</section>
{% endblock %}
