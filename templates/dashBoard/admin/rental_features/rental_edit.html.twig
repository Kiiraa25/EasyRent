{% extends 'dashBoard/base.html.twig' %}

{% block importmap %}
	{{ importmap(['app', 'componentsStyle']) }}

{% endblock %}

{% block title %}Éditer la location - Easy-Rent
{% endblock %}

{% block content %}

	<section class="admin-dashboard-content">
		<h1 class="dashboard-title">Éditer la location</h1>


		{{ form_start(form) }}

		{{ form_row(form.startDate) }}

		{{ form_row(form.endDate) }}

		{{ form_row(form.paymentMethod) }}

		{{ form_row(form.totalPrice) }}

		{{ form_row(form.mileageLimit) }}

		<div class="form-submit-block">
			<a href="{{ path('app_admin_rentals') }}" class="back-link">Retour à la page profil</a>

			<button type="submit" class="nav-button" onclick="return confirm('Êtes-vous sûr de vouloir mettre à jour les informations de cette location ?');">Modifier</button>
		</div>

		{{ form_end(form) }}


	</section>

{% endblock %}
