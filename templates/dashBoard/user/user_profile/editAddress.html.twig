{% extends 'dashBoard/base.html.twig' %}

{% block title %}Modifier mon addresse - Easy-Rent
{% endblock %}

{% block content %}


	<section class="admin-dashboard-content">
	<div class="form-container">
		<h1 class="dashboard-title">
			Modifier mon profil
		</h1>

		{{ form_start(form) }}


		<h3>Adresse</h3>
		{{ form_row(form.address,{ label: 'Adresse'}) }}
		{{ form_row(form.postalCode,{ label: 'Code postal'}) }}
		{{ form_row(form.city,{ label: 'Ville'}) }}
		{{ form_row(form.country,{ label: 'Pays'}) }}


		<div class="form-submit-block">
			<a href="{{ path('app_user_profile_edit') }}" class="back-link">Retour à la page profil</a>

			<button type="submit" class="nav-button">Modifier</button>
		</div>
		{{ form_end(form) }}
		</div>


	</section>


{% endblock %}
