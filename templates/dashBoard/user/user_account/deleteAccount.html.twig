{% extends 'dashBoard/base.html.twig' %}
{# {% extends 'base.html.twig' %} #}

{% block title %}Supprimer mon compte - Easy-Rent
{% endblock %}

{% block content %}
	{% for flash_error in app.flashes('verify_email_error') %}
		<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
	{% endfor %}

	<section class="admin-dashboard-content">


		<h3>Supprimer mon compte</h3>
		{{ form_start(DeleteAccountForm) }}
		{{ form_row(DeleteAccountForm.password) }}


		<div class="form-submit-block">
			<a href="{{ path('app_user_edit') }}" class="back-link">Retour aux paramètres de compte</a>

			<button type="submit" class="nav-button" onclick="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible');">Supprimer mon compte</button>
		</div>


		{{ form_end(DeleteAccountForm) }}


	</section>
{% endblock %}
