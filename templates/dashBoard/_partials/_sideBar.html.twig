<div class="sidebar">
    <div class="top-section">
        <h3>Tableau de Bord</h3>
        <ul>
            {% if is_granted('ROLE_ADMIN') %}
                <!-- Menu Admin -->
                <li><a href="{{ path('app_admin_dashboard') }}"><i class="fas fa-tachometer-alt"></i>Tableau de bord</a></li>
                <li><a href="{{ path('app_admin_users') }}"><i class="fas fa-users"></i>Utilisateurs</a></li>
                <li><a href="{{ path('app_admin_vehicles') }}"><i class="fas fa-car"></i>Véhicules</a></li>
                <li><a href="{{ path('app_admin_rentals') }}"><i class="fas fa-calendar-alt"></i>Locations</a></li>
                <li><a href="#"><i class="fas fa-file-alt"></i>Rapports</a></li>
                <li><a href="#"><i class="fas fa-cog"></i>Paramètres</a></li>
            

            <!-- Menu Utilisateur Déroulant -->
            	<li class="user-menu-toggle" onclick="toggleUserMenu()">
                	<a href="javascript:void(0);">Menu utilisateur <i class="fas fa-chevron-down"></i></a>
           	 	</li>
         		<div id="user-menu" class="user-menu">
                	<li><a href="{{ path('app_admin_dashboard') }}"><i class="fas fa-tachometer-alt"></i>Tableau de bord</a></li>
                	<li><a href="{{ path('app_user_profile_verify') }}"><i class="fas fa-users"></i>Vérifier mon profil</a></li>
                	<li><a href="{{ path('app_user_profile_edit') }}"><i class="fas fa-car"></i>Modifier mon profil</a></li>
                	<li><a href="{{ path('app_user_edit') }}"><i class="fas fa-calendar-alt"></i>Paramètres de compte</a></li>
                	<li><a href="#"><i class="fas fa-file-alt"></i>Moyens de paiement</a></li>
                	<li><a href="#"><i class="fas fa-cog"></i>Paramètres de paiement</a></li>
           	 	</div>


				{% elseif is_granted('ROLE_USER')%}
					 {# menu user fixe #}
                	<li><a href="{{ path('app_admin_dashboard') }}"><i class="fas fa-tachometer-alt"></i>Tableau de bord</a></li>
                	<li><a href="{{ path('app_user_profile_verify') }}"><i class="fas fa-users"></i>Vérifier mon profil</a></li>
                	<li><a href="{{ path('app_user_profile_edit') }}"><i class="fas fa-car"></i>Modifier mon profil</a></li>
                	<li><a href="{{ path('app_user_edit') }}"><i class="fas fa-calendar-alt"></i>Paramètres de compte</a></li>
                	<li><a href="#"><i class="fas fa-file-alt"></i>Moyens de paiement</a></li>
                	<li><a href="#"><i class="fas fa-cog"></i>Paramètres de paiement</a></li>
           	{% endif %}
        </ul>
    </div>

				

    <!-- Section bas de page avec le profil utilisateur -->
    <div class="bottom-section">
        <div class="user-profile" onclick="window.location.href='{{ path('app_user_edit') }}'">
		{% if app.user.profile.picture is not null %}
		<img src="{{ vich_uploader_asset(app.user.profile, 'imageFile') }}" alt="Photo de profil">
		{% else %}
            <img src="{{ asset('img/default-user-icon.png') }}" alt="Photo de profil">
			{% endif %}
            <span>{{ app.user.profile.lastName }} {{ app.user.profile.firstName }}</span>
        </div>
        <a href="{{ path('app_logout') }}" class="logout"><i class="fas fa-sign-out-alt"></i></a>
    </div>
</div>

<script>
function toggleUserMenu() {
    const userMenu = document.getElementById('user-menu');
    if (userMenu.style.display === 'none' || userMenu.style.display === '') {
        userMenu.style.display = 'block';
    } else {
        userMenu.style.display = 'none';
    }
}
</script>
