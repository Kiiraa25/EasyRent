<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<html lang="fr">
		<link rel="icon" href="{{ asset('/img/favicon/favicon-16x16.png') }}" sizes="16x16" type="image/png">
		<link rel="icon" href="{{ asset('/img/favicon/favicon-32x32.png') }}" sizes="32x32" type="image/png">

		<title>
			{% block title %}Easy-Rent
			{% endblock %}
		</title>

		{% block meta_description %}{% endblock %}
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet"> {% block stylesheets %}{% endblock %}
		<link
		rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

		{% block javascripts %}
			{% block importmap %}
				{{ importmap(['app']) }}
			{% endblock %}
		{% endblock %}


		<meta
		name="viewport" content="width=device-width, initial-scale=1.0">
		<!-- Start cookieyes banner -->
		<script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/0f3570ee34bd13f02d04de90/script.js"></script>
		<!-- End cookieyes banner -->
	</head>

	<body>
		{% block navbar %}
			{% include '_partials/_navbar.html.twig' %}
		
		{% endblock %}

		{% block header %}{% endblock %}


		{% block body %}

			{% block content %}{% endblock %}

		{% endblock %}

		{% block footer %}
			{% include '_partials/_footer.html.twig' %}
		{% endblock %}

	</body>
</html>
